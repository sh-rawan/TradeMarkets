# Copy this file to secrets.properties and fill in your values.
# secrets.properties is git-ignored - never commit it.

# Token from https://partners.viber.com
viber.auth-token=put-your-token-here

# Public HTTPS URL that forwards to this app (e.g. from `ngrok http 8080`).
# Leave empty to skip webhook registration on startup.
viber.webhook-url=
