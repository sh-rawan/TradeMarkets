<?xml version="1.0" encoding="UTF-8"?>
<!--
  Log files are split by category under ${LOG_ROOT}:
    application/  everything (full log)
    messages/     incoming messages and replies   (logger "viber.messages")
    events/       subscribe, webhook, conversation (logger "viber.events")
    errors/       WARN and ERROR from anywhere
  Folder, retention and file size come from logging.properties.
  Files older than log.max-history days are deleted at startup and at each daily rollover.
-->
<configuration>
	<include resource="org/springframework/boot/logging/logback/defaults.xml"/>
	<include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

	<springProperty name="LOG_ROOT" source="log.dir" defaultValue="logs"/>
	<springProperty name="MAX_HISTORY" source="log.max-history" defaultValue="7"/>
	<springProperty name="MAX_FILE_SIZE" source="log.max-file-size" defaultValue="10MB"/>

	<property name="FILE_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} : %msg%n"/>

	<appender name="APPLICATION" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<file>${LOG_ROOT}/application/application.log</file>
		<rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
			<fileNamePattern>${LOG_ROOT}/application/application-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
			<maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
			<maxHistory>${MAX_HISTORY}</maxHistory>
			<cleanHistoryOnStart>true</cleanHistoryOnStart>
		</rollingPolicy>
		<encoder><pattern>${FILE_PATTERN}</pattern></encoder>
	</appender>

	<appender name="MESSAGES" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<file>${LOG_ROOT}/messages/messages.log</file>
		<rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
			<fileNamePattern>${LOG_ROOT}/messages/messages-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
			<maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
			<maxHistory>${MAX_HISTORY}</maxHistory>
			<cleanHistoryOnStart>true</cleanHistoryOnStart>
		</rollingPolicy>
		<encoder><pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level : %msg%n</pattern></encoder>
	</appender>

	<appender name="EVENTS" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<file>${LOG_ROOT}/events/events.log</file>
		<rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
			<fileNamePattern>${LOG_ROOT}/events/events-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
			<maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
			<maxHistory>${MAX_HISTORY}</maxHistory>
			<cleanHistoryOnStart>true</cleanHistoryOnStart>
		</rollingPolicy>
		<encoder><pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level : %msg%n</pattern></encoder>
	</appender>

	<appender name="ERRORS" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<filter class="ch.qos.logback.classic.filter.ThresholdFilter">
			<level>WARN</level>
		</filter>
		<file>${LOG_ROOT}/errors/errors.log</file>
		<rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
			<fileNamePattern>${LOG_ROOT}/errors/errors-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
			<maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
			<maxHistory>${MAX_HISTORY}</maxHistory>
			<cleanHistoryOnStart>true</cleanHistoryOnStart>
		</rollingPolicy>
		<encoder><pattern>${FILE_PATTERN}</pattern></encoder>
	</appender>

	<!-- Category loggers also flow to the root appenders (console, application, errors). -->
	<logger name="viber.messages" level="INFO">
		<appender-ref ref="MESSAGES"/>
	</logger>
	<logger name="viber.events" level="INFO">
		<appender-ref ref="EVENTS"/>
	</logger>

	<root level="INFO">
		<appender-ref ref="CONSOLE"/>
		<appender-ref ref="APPLICATION"/>
		<appender-ref ref="ERRORS"/>
	</root>
</configuration>
