<?xml version="1.0" encoding="UTF-8"?>
<!--
  One app for all your broker accounts.
    broker-common    core: accounts, DB tables, periodic sync, orders, REST API
    broker-zerodha   Zerodha (Kite Connect) connector
    broker-angelone  Angel One (SmartAPI) connector
    broker-app       the app you run: includes every connector, reads accounts.properties
  A new broker = a new connector module, added to broker-app (see README.md).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.2</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.trademarkets</groupId>
	<artifactId>broker-apps</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>BrokerApps</name>

	<properties>
		<java.version>21</java.version>
	</properties>

	<modules>
		<module>broker-common</module>
		<module>broker-zerodha</module>
		<module>broker-angelone</module>
		<module>broker-app</module>
	</modules>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>com.trademarkets</groupId>
				<artifactId>broker-common</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.trademarkets</groupId>
				<artifactId>broker-zerodha</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.trademarkets</groupId>
				<artifactId>broker-angelone</artifactId>
				<version>${project.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

</project>
