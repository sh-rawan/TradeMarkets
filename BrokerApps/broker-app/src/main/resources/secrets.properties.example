# Copy to secrets.properties (git-ignored) and fill in. Broker account keys go in accounts.properties.
spring.datasource.password=put-your-postgres-password-here

# AES key that encrypts login tokens in the DB. Generate once: openssl rand -base64 32
# Don't change it later, or saved logins can't be read (just log in again if that happens).
app.encryption-key=
